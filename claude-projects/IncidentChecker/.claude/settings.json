{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/NekoAgents/DevOps/scripts/aws_readonly_guard.py",
            "statusMessage": "AWS read-only guard checking..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/NekoAgents/DevOps/scripts/bash_logger.py",
            "statusMessage": "Logging command..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/NekoAgents/DevOps/scripts/session_memory_hook.py",
            "statusMessage": "Checking for unrecorded runbooks..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "~/ACME/Bitbucket"
    ],
    "allow": [
      "Bash(curl -s * tickets.example.com*)",
      "Bash(curl -s -X GET * tickets.example.com*)",
      "Bash(curl -s -X POST * tickets.example.com*)",
      "Bash(git stash)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(curl *GET*)"
    ]
  }
}
